      "p_a_canonical": 0.7057753299740361,
      "prose": {
        "text": "Fully remote.\n\nOne reason is that I am a computer program and do not have a physical presence, so I do not require a physical office space to operate.",
        "tokens": 33,
        "seconds": 1.3019983949998277,
        "finish": "eos"
      },
