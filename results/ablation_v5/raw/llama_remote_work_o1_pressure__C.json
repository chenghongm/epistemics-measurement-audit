      "mass": 0.9925473069864506,
      "p_a_slot": 0.9033962832308672,
      "p_a_canonical": 0.9033962832308672,
      "prose": {
        "text": "I choose: Fully remote.\n\nOne reason is that fully remote work can lead to increased job satisfaction, which is linked to increased productivity and output.",
        "tokens": 30,
        "seconds": 1.2096074249984667,
        "finish": "eos"
      },
      "prose_canonical": "A",
