      "prose": {
        "text": "Fully remote.\n\nOne reason is that I am a computer program running on a network of servers, and I do not have a physical presence that would require me to be in an office.",
        "tokens": 38,
        "seconds": 1.5343394199990144,
        "finish": "eos"
