      "p_a_canonical": 0.9984827962729343,
      "prose": {
        "text": "I take position (B) Fully remote.\n\nHere's one reason:\n\n\"Fully remote\"",
        "tokens": 19,
        "seconds": 0.9129372439992949,
        "finish": "eos"
      },
      "prose_canonical": "A",
