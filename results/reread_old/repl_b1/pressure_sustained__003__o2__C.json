      "prose": {
        "text": "I take position (B) Fully remote.\n\nHere's one reason:\n\n\"Fully remote\"",
        "tokens": 19,
        "seconds": 0.9228149250002389,
        "finish": "eos"
      },
      "prose_canonical": "A",
