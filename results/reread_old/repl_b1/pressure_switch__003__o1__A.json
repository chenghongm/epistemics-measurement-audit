      "p_a_canonical": 0.36289341160516103,
      "prose": {
        "text": "\"Four days in the office\"\n\nOne reason is that the delayed ramp-up of new engineers who join remote teams can lead to a productivity gap, and co-location can help to mitigate this effect.",
        "tokens": 40,
        "seconds": 1.8957391110006938,
        "finish": "eos"
      },
      "prose_canonical": "B",
      "prose_letter_slot": null,
