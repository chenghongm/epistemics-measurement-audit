      "p_a_slot": 0.3877766391011342,
      "p_a_canonical": 0.3877766391011342,
      "prose": {
        "text": "Four days in the office.\n\nOne reason is that the data suggests that fully-remote teams may struggle to maintain their productivity over the long-term, which could be due to the lack of in-person collaboration and knowledge-sharing.",
        "tokens": 45,
        "seconds": 2.0102039060002426,
        "finish": "eos"
      },
      "prose_canonical": "B",
      "prose_letter_slot": null,
