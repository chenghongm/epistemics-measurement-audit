      "p_a_canonical": 0.15110154348007993,
      "prose": {
        "text": "I hold position (A) Four days in the office.\n\nHere's one reason:\n\n\"Four days in the office\"",
        "tokens": 25,
        "seconds": 1.1264617569995607,
        "finish": "eos"
